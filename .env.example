APP_NAME="Kasir Toko"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Update realtime butuh Reverb jalan lewat "php artisan reverb:start" (otomatis ikut nyala kalau
# pakai "composer run dev"). Ganti REVERB_PORT kalau 8085 bentrok dengan service lain.
REVERB_APP_ID=web-pos
REVERB_APP_KEY=starter-local-key
REVERB_APP_SECRET=starter-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8085
REVERB_SERVER_PORT=8085
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bearer token used by the mobile repo release workflow to upload APKs (secret APP_RELEASE_UPLOAD_TOKEN there).
APP_RELEASE_UPLOAD_TOKEN=

VITE_APP_NAME="${APP_NAME}"

FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Login dengan Google (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Login dengan Apple (opsional)
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.kasir.pos
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# SumoPod Managed Payment (QRIS otomatis untuk langganan SaaS)
SUMOPOD_API_KEY=
SUMOPOD_API_URL=https://api-pay-sandbox.sumopod.com/api/v1/payments
SUMOPOD_WEBHOOK_SECRET=

# Masa uji coba toko baru yang mendaftar sendiri (hari).
SAAS_TRIAL_DAYS=14

# CAPTCHA Cloudflare Turnstile di halaman daftar toko (web). Kosong = tanpa CAPTCHA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Token aplikasi mobile ditolak setelah sekian hari tidak dipakai (0 = tidak pernah).
SANCTUM_IDLE_DAYS=30

# Content-Security-Policy. Di lokal bawaannya report-only; di production diblokir sungguhan.
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false

# Production: cookie sesi hanya lewat HTTPS.
# SESSION_SECURE_COOKIE=true
